# ==============================================================================
# IQ VIP Task Platform - Environment Configuration Variables
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# Cryptographic & Session Secrets
JWT_SECRET=iq-vip-secure-production-jwt-key-39847291839218-production-entropy
SESSION_EXPIRY_HOURS=48

# Primary Production Database (PostgreSQL)
# When deploying to production with PostgreSQL / Docker / Supabase / Neon:
DATABASE_URL=postgresql://iq_user:StrongPassword@localhost:5432/iq_vip_db

# Local Embedded Engine Path (Node Native Database)
DB_PATH=./iq_vip.db

# Task Engine Configuration
TASK_PROCESSING_DURATION_SECONDS=30
MIN_WITHDRAWAL_AMOUNT=20.00
DEFAULT_WITHDRAWAL_FEE_PCT=2.0
DEMO_INITIAL_BALANCE=1000.00
REQUIRE_DEPOSIT_TO_UNLOCK=false
INSTANT_SETTLEMENT=true

# External Payment Gateway Hooks (Identified for production wiring)
# Note: In default installation, manual verification or mock ledger is active.
# To integrate real crypto/fiat payouts:
TRON_GRID_API_KEY=
ZAIN_CASH_MERCHANT_ID=
ZAIN_CASH_SECRET=
QI_CARD_API_KEY=
